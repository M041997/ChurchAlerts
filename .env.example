NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for production push fanout.
PUSH_NOTIFY_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Used by Capacitor when building the native iOS wrapper for TestFlight.
# Example: CAPACITOR_SERVER_URL=https://your-project.vercel.app
CAPACITOR_SERVER_URL=https://your-deployed-app.example.com
